{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hub command",
  "description": "fsf/<site>/hub/cmd. Operator actions; the hub applies its limits and interlocks and answers on hub/reply.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Chosen by the sender; echoed in the reply"
    },
    "name": {
      "enum": [
        "advance_stage",
        "water_now",
        "set_override",
        "clear_override",
        "pause_zone",
        "resume_zone",
        "actuator_test"
      ]
    },
    "by": {
      "type": "string",
      "description": "Who sent it, for the event log"
    },
    "planting": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "zone": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "device": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "loop": {
      "type": "string"
    },
    "quantity": {
      "type": "string"
    },
    "volume_ml": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "target": {
      "type": "number"
    },
    "min": {
      "type": "number"
    },
    "max": {
      "type": "number"
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(s|m|h|d)$",
      "description": "Duration, e.g. 30s, 5m, 2h, 14d"
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "name": {
            "const": "advance_stage"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "required": [
          "planting"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "water_now"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "required": [
          "zone"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "set_override"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "required": [
          "zone",
          "quantity",
          "duration"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "clear_override"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "required": [
          "zone"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "pause_zone"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "required": [
          "zone"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "resume_zone"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "required": [
          "zone"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "name": {
            "const": "actuator_test"
          }
        },
        "required": [
          "name"
        ]
      },
      "then": {
        "required": [
          "device"
        ]
      }
    }
  ]
}
