{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hub command reply",
  "description": "fsf/<site>/hub/reply",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "t": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "t",
    "ok"
  ],
  "additionalProperties": false
}
